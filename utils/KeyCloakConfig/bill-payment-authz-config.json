{
  "allowRemoteResourceManagement": true,
  "policyEnforcementMode": "ENFORCING",
  "resources": [
    {
      "name": "bill",
      "type": "None",
      "ownerManagedAccess": false,
      "displayName": "Boletos: entrada, verificacao e decisao",
      "scopes": [
        {
          "name": "view"
        },
        {
          "name": "import"
        },
        {
          "name": "validate"
        },
        {
          "name": "approve"
        },
        {
          "name": "deny"
        },
        {
          "name": "cancel"
        }
      ]
    },
    {
      "name": "payer-profile",
      "type": "None",
      "ownerManagedAccess": false,
      "displayName": "Cadastro fiscal do tenant (deriva senha de PDF e roteamento)",
      "scopes": [
        {
          "name": "view"
        },
        {
          "name": "manage"
        }
      ]
    },
    {
      "name": "payee",
      "type": "None",
      "ownerManagedAccess": false,
      "displayName": "Beneficiarios cadastrados",
      "scopes": [
        {
          "name": "view"
        },
        {
          "name": "manage"
        }
      ]
    },
    {
      "name": "origin",
      "type": "None",
      "ownerManagedAccess": false,
      "displayName": "Origens confiaveis (remetentes)",
      "scopes": [
        {
          "name": "view"
        },
        {
          "name": "manage"
        }
      ]
    },
    {
      "name": "capture-source",
      "type": "None",
      "ownerManagedAccess": false,
      "displayName": "Caixas de e-mail monitoradas",
      "scopes": [
        {
          "name": "view"
        },
        {
          "name": "manage"
        },
        {
          "name": "sync"
        }
      ]
    },
    {
      "name": "capture-item",
      "type": "None",
      "ownerManagedAccess": false,
      "displayName": "Artefatos capturados e quarentena",
      "scopes": [
        {
          "name": "view"
        },
        {
          "name": "claim"
        },
        {
          "name": "reprocess"
        }
      ]
    },
    {
      "name": "expectation",
      "type": "None",
      "ownerManagedAccess": false,
      "displayName": "Expectativas de boleto e alertas do que nao chegou",
      "scopes": [
        {
          "name": "view"
        },
        {
          "name": "manage"
        },
        {
          "name": "waive"
        }
      ]
    },
    {
      "name": "captured-message",
      "displayName": "Livro-caixa da captura",
      "type": "urn:bill-payment-api:resources:captured-message",
      "ownerManagedAccess": false,
      "scopes": [
        {
          "name": "view"
        },
        {
          "name": "recapture"
        }
      ]
    },
    {
      "name": "capture-retention",
      "displayName": "Retencao do livro-caixa",
      "type": "urn:bill-payment-api:resources:capture-retention",
      "ownerManagedAccess": false,
      "scopes": [
        {
          "name": "view"
        },
        {
          "name": "manage"
        }
      ]
    }
  ],
  "policies": [
    {
      "name": "Bill Admin Policy",
      "description": "Administra o BC inteiro: cadastros, captura, expectativas e decisao sobre boleto.",
      "type": "role",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "roles": "[{\"id\":\"bill-payment-api/bill-admin\",\"required\":false}]"
      }
    },
    {
      "name": "Bill Approver Policy",
      "description": "Decide o destino do boleto. E o papel sensivel: aprovar e o que autoriza dinheiro sair (ADR-007).",
      "type": "role",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "roles": "[{\"id\":\"bill-payment-api/bill-admin\",\"required\":false},{\"id\":\"bill-payment-api/bill-approver\",\"required\":false}]"
      }
    },
    {
      "name": "Bill Operator Policy",
      "description": "Opera o dia a dia: importa, revalida, mantem cadastros, sincroniza caixa e reivindica item. NAO decide boleto.",
      "type": "role",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "roles": "[{\"id\":\"bill-payment-api/bill-admin\",\"required\":false},{\"id\":\"bill-payment-api/bill-operator\",\"required\":false}]"
      }
    },
    {
      "name": "Bill Viewer Policy",
      "description": "So leitura. Todo papel deste BC alcanca a leitura.",
      "type": "role",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "roles": "[{\"id\":\"bill-payment-api/bill-admin\",\"required\":false},{\"id\":\"bill-payment-api/bill-approver\",\"required\":false},{\"id\":\"bill-payment-api/bill-operator\",\"required\":false},{\"id\":\"bill-payment-api/bill-viewer\",\"required\":false}]"
      }
    },
    {
      "name": "Bill Read Permission",
      "description": "Consultar boletos, cadastros, captura e expectativas.",
      "type": "scope",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "resources": "[\"bill\",\"payer-profile\",\"payee\",\"origin\",\"capture-source\",\"capture-item\",\"expectation\"]",
        "scopes": "[\"view\"]",
        "applyPolicies": "[\"Bill Viewer Policy\"]"
      }
    },
    {
      "name": "Bill Operation Permission",
      "description": "Importar, revalidar, manter cadastros, sincronizar caixa, reivindicar, reprocessar e cadastrar expectativa.",
      "type": "scope",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "resources": "[\"bill\",\"payer-profile\",\"payee\",\"origin\",\"capture-source\",\"capture-item\",\"expectation\"]",
        "scopes": "[\"import\",\"validate\",\"manage\",\"sync\",\"claim\",\"reprocess\"]",
        "applyPolicies": "[\"Bill Operator Policy\"]"
      }
    },
    {
      "name": "Bill Decision Permission",
      "description": "Aprovar, recusar e cancelar boleto. Separada da operacao de proposito: quem importa nao decide.",
      "type": "scope",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "resources": "[\"bill\"]",
        "scopes": "[\"approve\",\"deny\",\"cancel\"]",
        "applyPolicies": "[\"Bill Approver Policy\"]"
      }
    },
    {
      "name": "Expectation Waive Permission",
      "description": "Dispensar ciclo de expectativa e silenciar a rede de seguranca daquela conta (ADR-014) — por isso vai com quem decide, nao com quem cadastra.",
      "type": "scope",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "resources": "[\"expectation\"]",
        "scopes": "[\"waive\"]",
        "applyPolicies": "[\"Bill Approver Policy\"]"
      }
    },
    {
      "name": "Captured Message Read Permission",
      "description": "Consultar o historico de e-mails lidos pela captura. Recurso proprio: a quarentena e fila de trabalho, isto e historico e inclui o e-mail descartado.",
      "type": "scope",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "resources": "[\"captured-message\"]",
        "scopes": "[\"view\"]",
        "applyPolicies": "[\"Bill Viewer Policy\"]"
      }
    },
    {
      "name": "Captured Message Recapture Permission",
      "description": "Reprocessar um e-mail do zero. Escopo proprio porque reingerir consome cota do extrator de visao, pela mesma razao que separou capture-item:reprocess.",
      "type": "scope",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "resources": "[\"captured-message\"]",
        "scopes": "[\"recapture\"]",
        "applyPolicies": "[\"Bill Operator Policy\"]"
      }
    },
    {
      "name": "Capture Retention Read Permission",
      "description": "Ver o prazo de retencao em vigor. Quem opera precisa dele para interpretar a tela.",
      "type": "scope",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "resources": "[\"capture-retention\"]",
        "scopes": "[\"view\"]",
        "applyPolicies": "[\"Bill Viewer Policy\"]"
      }
    },
    {
      "name": "Capture Retention Manage Permission",
      "description": "Ligar, desligar e escolher o prazo de retencao do historico. Decisao de instalacao, nao de operacao — por isso fica com o administrador.",
      "type": "scope",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "resources": "[\"capture-retention\"]",
        "scopes": "[\"manage\"]",
        "applyPolicies": "[\"Bill Admin Policy\"]"
      }
    }
  ],
  "scopes": [
    {
      "name": "view"
    },
    {
      "name": "import"
    },
    {
      "name": "validate"
    },
    {
      "name": "approve"
    },
    {
      "name": "deny"
    },
    {
      "name": "cancel"
    },
    {
      "name": "manage"
    },
    {
      "name": "sync"
    },
    {
      "name": "claim"
    },
    {
      "name": "reprocess"
    },
    {
      "name": "waive"
    },
    {
      "name": "recapture"
    }
  ],
  "decisionStrategy": "UNANIMOUS"
}
