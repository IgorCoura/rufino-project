  "policies": [
    {
      "name": "People Viewer Policy",
      "description": "So leitura. Todo papel deste BC alcanca a leitura.",
      "type": "role",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "roles": "[{\"id\":\"people-management-api/people-admin\",\"required\":false},{\"id\":\"people-management-api/people-operator\",\"required\":false},{\"id\":\"people-management-api/people-doc-operator\",\"required\":false},{\"id\":\"people-management-api/people-reviewer\",\"required\":false},{\"id\":\"people-management-api/people-viewer\",\"required\":false}]"
      }
    },
    {
      "name": "People Document Operation Policy",
      "description": "Quem trabalha a documentacao: cria, edita, sobe arquivo, gera e manda assinar. Inclui o operador completo, que faz isso e mais o cadastro de pessoas.",
      "type": "role",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "roles": "[{\"id\":\"people-management-api/people-admin\",\"required\":false},{\"id\":\"people-management-api/people-operator\",\"required\":false},{\"id\":\"people-management-api/people-doc-operator\",\"required\":false}]"
      }
    },
    {
      "name": "People Employee Operation Policy",
      "description": "Cadastro de pessoas. NAO inclui o people-doc-operator: ele mexe na documentacao e nao no cadastro.",
      "type": "role",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "roles": "[{\"id\":\"people-management-api/people-admin\",\"required\":false},{\"id\":\"people-management-api/people-operator\",\"required\":false}]"
      }
    },
    {
      "name": "People Review Policy",
      "description": "Validacao de conformidade: aprovar e marcar como nao aplicavel. E a decisao que fecha o documento, e por isso tem papel proprio.",
      "type": "role",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "roles": "[{\"id\":\"people-management-api/people-admin\",\"required\":false},{\"id\":\"people-management-api/people-reviewer\",\"required\":false}]"
      }
    },
    {
      "name": "People Document Rejection Policy",
      "description": "Reprovar e depreciar documento. Fica com quem revisa E com quem opera: recusar um arquivo ilegivel e devolve-lo para reenvio e trabalho de operacao, nao decisao de conformidade.",
      "type": "role",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "roles": "[{\"id\":\"people-management-api/people-admin\",\"required\":false},{\"id\":\"people-management-api/people-reviewer\",\"required\":false},{\"id\":\"people-management-api/people-operator\",\"required\":false},{\"id\":\"people-management-api/people-doc-operator\",\"required\":false}]"
      }
    },
    {
      "name": "People Admin Policy",
      "description": "Configuracao da instalacao: modelos, exigencias por cargo, empresa, departamentos, cargos, funcoes e locais.",
      "type": "role",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "roles": "[{\"id\":\"people-management-api/people-admin\",\"required\":false}]"
      }
    },
    {
      "name": "People Signature Webhook Policy",
      "description": "Retorno do provedor de assinatura. Vive numa service account e alcanca UM escopo.",
      "type": "role",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "fetchRoles": "false",
        "roles": "[{\"id\":\"people-management-api/people-signature-webhook\",\"required\":false}]"
      }
    },
    {
      "name": "People Read Permission",
      "description": "Consultar. Todo papel do BC alcanca.",
      "type": "scope",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "resources": "[\"employee\", \"document\", \"document-template\", \"document-group\", \"require-documents\", \"company\", \"department\", \"position\", \"role\", \"workplace\"]",
        "scopes": "[\"view\"]",
        "applyPolicies": "[\"People Viewer Policy\"]"
      }
    },
    {
      "name": "People Download Permission",
      "description": "Baixar arquivo. So os tres recursos que tem arquivo declaram o escopo.",
      "type": "scope",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "resources": "[\"employee\", \"document\", \"document-template\"]",
        "scopes": "[\"download\"]",
        "applyPolicies": "[\"People Viewer Policy\"]"
      }
    },
    {
      "name": "People Document Operation Permission",
      "description": "Trabalhar a documentacao: criar, editar, subir arquivo, gerar e mandar assinar.",
      "type": "scope",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "resources": "[\"document\"]",
        "scopes": "[\"create\", \"edit\", \"upload\", \"generate\", \"send2sign\"]",
        "applyPolicies": "[\"People Document Operation Policy\"]"
      }
    },
    {
      "name": "People Require Documents Generate Permission",
      "description": "Disparar a geracao dos documentos exigidos por um cargo. E ROTINA — definir QUAIS documentos o cargo exige e configuracao, e vive na permissao de admin.",
      "type": "scope",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "resources": "[\"require-documents\"]",
        "scopes": "[\"generate\"]",
        "applyPolicies": "[\"People Document Operation Policy\"]"
      }
    },
    {
      "name": "People Employee Operation Permission",
      "description": "Cadastro de pessoas. Separado do documento de proposito: e o que distingue o people-operator do people-doc-operator.",
      "type": "scope",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "resources": "[\"employee\"]",
        "scopes": "[\"create\",\"edit\",\"upload\"]",
        "applyPolicies": "[\"People Employee Operation Policy\"]"
      }
    },
    {
      "name": "People Document Review Permission",
      "description": "Aprovar e marcar como nao aplicavel: e a decisao de conformidade que fecha o documento.",
      "type": "scope",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "resources": "[\"document\"]",
        "scopes": "[\"approve\",\"mark-not-applicable\"]",
        "applyPolicies": "[\"People Review Policy\"]"
      }
    },
    {
      "name": "People Document Rejection Permission",
      "description": "Reprovar e depreciar. Alcanca tambem os dois operadores — devolver arquivo ilegivel e trabalho do dia a dia.",
      "type": "scope",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "resources": "[\"document\"]",
        "scopes": "[\"reject\",\"deprecate\"]",
        "applyPolicies": "[\"People Document Rejection Policy\"]"
      }
    },
    {
      "name": "People Configuration Permission",
      "description": "Configuracao da instalacao: quem define o que a empresa exige. require-documents:create/edit esta AQUI, e nao na operacao — definir quais documentos um cargo exige e politica da empresa.",
      "type": "scope",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "resources": "[\"require-documents\", \"document-group\", \"company\", \"department\", \"position\", \"role\", \"workplace\"]",
        "scopes": "[\"create\", \"edit\"]",
        "applyPolicies": "[\"People Admin Policy\"]"
      }
    },
    {
      "name": "People Document Template Permission",
      "description": "Modelos de documento: o unico recurso de configuracao que tambem recebe arquivo.",
      "type": "scope",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "resources": "[\"document-template\"]",
        "scopes": "[\"create\", \"edit\", \"upload\"]",
        "applyPolicies": "[\"People Admin Policy\"]"
      }
    },
    {
      "name": "People Signature Webhook Permission",
      "description": "O unico escopo que a service account do provedor de assinatura alcanca.",
      "type": "scope",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "resources": "[\"document\"]",
        "scopes": "[\"webhook\"]",
        "applyPolicies": "[\"People Signature Webhook Policy\"]"
      }
    }
  ],
